# Supabase Configuration (Local Docker)
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# API Keys
# AI provider keys belong in Supabase secrets as GEMINI_API_KEY and
# OPENROUTER_API_KEY. Never add EXPO_PUBLIC_ AI keys here.
EXPO_PUBLIC_FINMIND_API_KEY=your-finmind-api-key
EXPO_PUBLIC_COINGECKO_API_KEY=your-coingecko-api-key
EXPO_PUBLIC_EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
