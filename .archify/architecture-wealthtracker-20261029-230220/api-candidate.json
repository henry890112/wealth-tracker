  "cards": [
    { "dot": "cyan", "title": "market-data｜最新報價", "items": ["請求：{ symbols: [{ symbol, market }], forceRefresh }；回應：quotes、errors、fetchedAt。", "先查 price_cache，失效後取 TWSE MIS／Yahoo／Nasdaq／Binance／CoinGecko；失敗可退回舊快取。", "App 的部分報價函式在 Edge 失敗時才直連來源；並非所有取得報價的入口都有同一個後備路徑。"] },
    { "dot": "cyan", "title": "market-history｜技術 K 線", "items": ["請求：symbol、marketType、days、includeIntraday、comparisonSymbols。", "回應：rows、benchmarkRows、relativeStrengthRows、comparisonRows、quote、quoteStatus 等。", "台股主要 FinMind，美股 Yahoo，幣種 Binance；盤中報價與完成日 K 有條件合併。"] },
    { "dot": "violet", "title": "financial-reports｜季報與日曆", "items": ["單股請求：symbol、marketType、forceRefresh；回應 quarters、monthlyRevenue、earningsCalendar、warnings。", "月曆請求：calendarMonth、marketType、symbols；台股回傳申報事件，美股回傳 Nasdaq 財報事件。", "台股季報來自 FinMind；美股正式數字來自 SEC；Yahoo 補充日曆與預估。"] },
    { "dot": "amber", "title": "market-overview｜市場總覽", "items": ["以 action 區分 tpex-index、tw-market-flow、tw-margin-history、tw-foreign-history、tpex-index-history、sp500-pe 等。", "資料來源包含 TWSE、TPEx、Multpl；部分 App 路徑有直接請求後備。"] },
    { "dot": "orange", "title": "options-analysis｜選擇權", "items": ["請求：market、symbol、action=expirations 或 chain，chain 另帶 expiration。", "台股由 TAIFEX；美股有 Tradier token 用 Tradier，否則用 Cboe 延遲快照。", "回應包含 expirations 或 contracts，並標示 provider、priceDelay、greeksDelay。"] },
    { "dot": "emerald", "title": "ai-chat｜AI", "items": ["請求：mode=generate／transcribe；生成回應 content、model、sources。", "後端先用 Gemini，生成無內容時才嘗試 OpenRouter；密鑰不放在 App bundle。"] },
    { "dot": "rose", "title": "通知與訊號", "items": ["signal-notifications 依 action 測試 Email／LINE 或產生綁定碼；排程掃描另走後端路徑。", "Resend 發 Email、LINE Messaging API 發訊息；daily-investment-signals 可向 Expo Push API 發送摘要。", "通知依設定、排程與條件觸發，不是每次開啟畫面必發。"] },
    { "dot": "slate", "title": "玉山與交易計畫", "items": ["E.Sun Bridge 只接受 GET /v1/holdings、/v1/balance、/v1/transactions；App 取回後再匯入 Supabase。", "tradePlan 透過 Supabase Data API 讀寫 trade_plan_settings、trade_plan_dynamic_stops，並使用 rebase_trade_plan_dynamic_stop RPC。", "此圖依本機尚未提交的工作目錄快照建立；不能據此判定線上部署版本。"] }
  ]
