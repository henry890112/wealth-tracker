  "cards": [
    { "dot": "cyan", "title": "行情路徑", "items": ["App marketData/quotes.js 優先 invoke market-data，回傳 quotes／errors／fetchedAt；失敗時才直連資料來源。", "技術 K 線 invoke market-history，回傳 rows、benchmarkRows、comparisonRows、quote 等；依台股／美股／幣種切換來源。", "行情來源包含 TWSE MIS、FinMind、Yahoo、Nasdaq、Binance、CoinGecko；不是每次都全部呼叫。"] },
    { "dot": "violet", "title": "財報、估值與期權", "items": ["financial-reports 查台股 FinMind 或美股 SEC，搭配 Yahoo 補充；回傳 quarters、monthlyRevenue、earningsCalendar、warnings。", "財報日曆對持倉／自選分台股與美股呼叫：台股申報事件、美股 Nasdaq 預估／已公告事件。", "options-analysis 台股取 TAIFEX；美股有 Tradier token 用 Tradier，否則 Cboe 延遲快照。", "另有 valuation-history、dcf-fundamentals、corporate-actions、market-overview 函式。"] },
    { "dot": "emerald", "title": "資產與持久資料", "items": ["資產、交易、自選、日快照由 Supabase Data API 讀寫；停損計畫使用 trade_plan_settings 與 trade_plan_dynamic_stops。", "market-data 以 price_cache 查詢、更新報價；financial-reports 使用 financial_reports_cache。", "此圖是本機工作目錄快照，不代表 Edge Functions 已部署到線上。"] },
    { "dot": "amber", "title": "AI、通知與玉山", "items": ["ai-chat 先用 Gemini，生成失敗時可用 OpenRouter 後備；密鑰留在後端。", "通知函式可依設定／排程透過 Resend 與 LINE 發送；不代表每次開 App 都會發送。", "E.Sun Bridge 提供 GET /v1/holdings、/v1/balance、/v1/transactions；App 另將匯入結果寫回 Supabase。"] },
    { "dot": "slate", "title": "重構狀態與證據", "items": ["features/trends、technical、tradePlan、marketData 已拆出；screens 與 services 仍有組裝與相容入口。", "節點的來源卡以目前本機工作目錄建立唯讀證據快照；快照未推送，與 GitHub HEAD 不同。", "本圖示意主要呼叫路徑；非每個畫面、表格、提供者與條件分支的完整清單。"] }
  ]
